# Beads task tracking — directory is tracked for issue sync; runtime/local
# files are excluded by .beads/.gitignore (dolt/, sqlite, locks, credential
# key, etc). Re-adding `.beads/` here would block `bd remember` / auto-export
# from staging issues.jsonl and events.jsonl, and break the dolt sync loop.

# Local AI tool config
.agents/
.agent/
.factory/
.cocoindex_code/
.codex/
.cursor/
.github/prompts/
.github/skills/
openspec/

# Git worktrees
.worktrees/
