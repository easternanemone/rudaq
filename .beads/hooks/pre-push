#!/usr/bin/env bash
# Composite pre-push hook for rust-daq
#
# Chains two checks:
#   1. Beads JSONL sync (prevents pushing stale issue data)
#   2. Quality gate: fmt + clippy + tests (mirrors CI)
#
# Skip with: git push --no-verify

set -e

# ── 1. Beads pre-push check ─────────────────────────────────────
if command -v bd >/dev/null 2>&1; then
    bd hooks run pre-push "$@"
else
    echo "Warning: bd command not found in PATH, skipping beads pre-push hook" >&2
    echo "  Install bd: brew install beads" >&2
fi

# ── 2. Quality gate (fmt + clippy + tests) ──────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel)"
GATE_SCRIPT="$REPO_ROOT/scripts/pre-push-gate.sh"

if [ -x "$GATE_SCRIPT" ]; then
    exec "$GATE_SCRIPT"
else
    echo "Warning: scripts/pre-push-gate.sh not found, skipping quality gate" >&2
fi
