# Host-specific environment for leabs-dev VM (pve3)
# Development VM with IPG laser, ThorLabs PM400, and Andor iSTAR sCMOS
#
# SSH access (via Tailscale):
#   ssh leabs-dev
#
# Hardware:
#   - IPG fiber laser (TCP, 10.0.0.15:10001)
#   - ThorLabs PM400 power meter (TCP, 10.0.0.16:10001)
#   - Andor iSTAR sCMOS (mock unless Andor SDK3 installed)
#
# Usage:
#   source config/hosts/leabs-dev.env

# ==============================================================================
# Andor SDK3 (optional - comment out if SDK not installed)
# ==============================================================================

# Uncomment if Andor SDK3 is installed on the VM:
# export ANDOR_SDK3_ROOT="/opt/andor/sdk3"
# export ANDOR_SDK3_LIB_DIR="/opt/andor/sdk3/lib"
# export LD_LIBRARY_PATH="/opt/andor/sdk3/lib:${LD_LIBRARY_PATH:-}"

# ==============================================================================
# Server Configuration
# ==============================================================================

# Bind to all interfaces for remote GUI access
export DAQ_DAEMON_BIND="0.0.0.0:50051"
