# Host-specific environment for leabs-dev VM (pve3)
# Development VM with IPG laser, ThorLabs PM400, and Andor iSTAR sCMOS
#
# SSH access (via Tailscale):
#   ssh leabs-dev
#
# Hardware:
#   - IPG fiber laser (TCP, 10.0.0.15:10001)
#   - ThorLabs PM400 power meter (TCP, 10.0.0.16:10001)
#   - Andor iSTAR sCMOS (USB, requires Andor SDK3)
#
# Usage:
#   source config/hosts/leabs-dev.env

# ==============================================================================
# Andor SDK3 (installed at /usr/local on leabs-dev)
# ==============================================================================
# build.rs expects ANDOR_SDK3_DIR with include/ and lib/ subdirectories.
# SDK installs headers to /usr/local/include/atcore.h and libs to /usr/local/lib/libatcore.so.

export ANDOR_SDK3_DIR="/usr/local"
export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LIBRARY_PATH="/usr/local/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"

# ==============================================================================
# Hardware Smoke Test Configuration
# ==============================================================================

export ANDOR_SMOKE_TEST="1"
export ANDOR_CAMERA_INDEX="0"

# ==============================================================================
# Server Configuration
# ==============================================================================

# Bind to all interfaces for remote GUI access
export DAQ_DAEMON_BIND="0.0.0.0:50051"
